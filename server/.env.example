# VASPTRACE API — environment configuration
# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/vasptrace

# Auth (required) — use a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated list supported)
CLIENT_URL=http://localhost:5173

# --- Chain data (GraphSense) ------------------------------------------------
# Leave GRAPHSENSE_API_URL empty to use the deterministic synthetic provider.
# Hosted: https://api.ikna.io  ·  self-hosted: http://localhost:9000
# In production the URL must be https and the key is mandatory.
GRAPHSENSE_API_URL=
GRAPHSENSE_API_KEY=
GRAPHSENSE_TIMEOUT_MS=12000

# --- EVM Chain data (Etherscan family) ---------------------------------------
# Optional API keys to unlock higher rate limits on Ethereum, Polygon, BSC, Arbitrum.
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=

# --- Complaint intake (NCRP / SAHYOG / LEA) ---------------------------------
# Comma-separated API keys presented as `x-api-key` on POST /api/intake/complaints.
# Leave empty to disable the machine-to-machine intake surface.
# Generate with: openssl rand -hex 32
INTAKE_API_KEYS=
